rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Mismo correo que adminEmails en App.jsx y MASTER_ADMIN_EMAIL en AdminUsersView.jsx.
    function isMasterAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'alonso.pinoo@gmail.com';
    }

    // Datos de entrenamiento de cada usuario: solo él los escribe; el admin puede verlos.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMasterAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Perfil ligero para la lista de alumnos del admin.
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMasterAdmin());
      allow write: if signedIn() && (request.auth.uid == uid || isMasterAdmin());
    }

    // Rutinas y librería compartidas: todos las leen, solo el admin las cambia.
    // Cada escritura debe subir la versión en uno (ver saveGlobalContent en userData.js):
    // una pestaña o versión vieja de la app no puede pisar lo que guardó otro dispositivo.
    match /content/{docId} {
      allow read: if signedIn();
      allow create: if isMasterAdmin() && request.resource.data.version == 1;
      allow update: if isMasterAdmin()
        && request.resource.data.version == resource.data.get('version', 0) + 1;
      allow delete: if false;
    }
  }
}
